[
  {
    "desc": "limit=0 是否被静默改成 1",
    "method": "GET",
    "path": "/api/v1/memories?limit=0",
    "status": 200,
    "expected": [
      200
    ],
    "pass": true,
    "body": "{\"total\":0,\"count\":0,\"limit\":1,\"offset\":0,\"has_more\":false,\"items\":[]}"
  },
  {
    "desc": "limit=-1 是否被静默夹住",
    "method": "GET",
    "path": "/api/v1/memories?limit=-1",
    "status": 400,
    "expected": [
      200
    ],
    "pass": false,
    "body": "{\"code\":\"bad_request\",\"message\":\"查询参数格式不正确：Failed to deserialize query string: limit: invalid digit "
  },
  {
    "desc": "limit 超上限是否夹住",
    "method": "GET",
    "path": "/api/v1/memories?limit=100000",
    "status": 200,
    "expected": [
      200
    ],
    "pass": true,
    "body": "{\"total\":0,\"count\":0,\"limit\":200,\"offset\":0,\"has_more\":false,\"items\":[]}"
  },
  {
    "desc": "超大 offset 是否空页而非 panic",
    "method": "GET",
    "path": "/api/v1/memories?offset=999999",
    "status": 200,
    "expected": [
      200
    ],
    "pass": true,
    "body": "{\"total\":0,\"count\":0,\"limit\":50,\"offset\":999999,\"has_more\":false,\"items\":[]}"
  },
  {
    "desc": "超长 q 是否仍可用",
    "method": "GET",
    "path": "/api/v1/memories?",
    "status": 200,
    "expected": [
      200
    ],
    "pass": true,
    "body": "{\"total\":0,\"count\":0,\"limit\":50,\"offset\":0,\"has_more\":false,\"items\":[]}"
  },
  {
    "desc": "非法枚举是否 422",
    "method": "GET",
    "path": "/api/v1/tasks?status=BOGUS",
    "status": 422,
    "expected": [
      422
    ],
    "pass": true,
    "body": "{\"code\":\"unprocessable_entity\",\"message\":\"请求参数校验未通过\",\"details\":{\"status\":\"可选 queued / running / su"
  },
  {
    "desc": "非数字 limit 是否 422",
    "method": "GET",
    "path": "/api/v1/tasks?limit=abc",
    "status": 400,
    "expected": [
      422
    ],
    "pass": false,
    "body": "{\"code\":\"bad_request\",\"message\":\"查询参数格式不正确：Failed to deserialize query string: limit: invalid digit "
  },
  {
    "desc": "非法 id 是否 404 而非 500",
    "method": "GET",
    "path": "/api/v1/memories/not-a-uuid",
    "status": 404,
    "expected": [
      404
    ],
    "pass": true,
    "body": "{\"code\":\"not_found\",\"message\":\"记忆不存在\"}"
  },
  {
    "desc": "不存在 id 是否 404",
    "method": "GET",
    "path": "/api/v1/memories/00000000-0000-0000-0000-000000000000",
    "status": 404,
    "expected": [
      404
    ],
    "pass": true,
    "body": "{\"code\":\"not_found\",\"message\":\"记忆不存在\"}"
  },
  {
